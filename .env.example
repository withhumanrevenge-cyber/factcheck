# Copy to .env and fill in. Never commit .env.

# Vercel AI Gateway key: used for Jev (arm A, D) and the strong reference LLM (arm C).
AI_GATEWAY_API_KEY=

# Groq key: used for the Groq LLM decider (arm B) and, later, the retrieval sub-agents.
GROQ_API_KEY=

# Decision model slug on the Gateway. Pin a versioned slug once GET /v1/models shows one.
JEV_MODEL=typesafe-ai/jev

# Groq model for arm B. Must support strict json_schema output (gpt-oss-120b, gpt-oss-20b, qwen/qwen3.8-27b).
GROQ_MODEL=openai/gpt-oss-120b

# Strong reference LLM for arm C and the arm D fallback, as a Gateway slug (provider/model). Required for arms C and D.
STRONG_MODEL=

# Samples per question for LLM arms. 1 = no probabilities; >1 = vote shares as probabilities.
LLM_SAMPLES=5

# Ask the Gateway for zero data retention (needs a Pro or Enterprise plan).
ZERO_DATA_RETENTION=false
